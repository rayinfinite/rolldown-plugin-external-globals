{
  "name": "rolldown-plugin-external-globals",
  "version": "0.1.0",
  "description": "Transform external imports into global variables for Rolldown. A Rust/oxc port of rollup-plugin-external-globals that reuses Rolldown's own AST tooling instead of re-parsing in JS.",
  "keywords": [
    "rolldown",
    "rolldown-plugin",
    "rollup-plugin",
    "external-globals",
    "oxc",
    "rust"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayinfinite/rolldown-plugin-external-globals.git"
  },
  "homepage": "https://github.com/rayinfinite/rolldown-plugin-external-globals#readme",
  "bugs": {
    "url": "https://github.com/rayinfinite/rolldown-plugin-external-globals/issues"
  },
  "type": "module",
  "main": "./plugin.mjs",
  "module": "./plugin.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./plugin.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.mjs",
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16"
  },
  "napi": {
    "binaryName": "rolldown-plugin-external-globals",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --esm",
    "build:debug": "napi build --platform --esm",
    "test": "node --test test/parity.test.mjs test/e2e.test.mjs test/rollup.test.mjs",
    "bench": "node test/bench.mjs"
  },
  "peerDependencies": {
    "rolldown": ">=1.0.0",
    "rollup": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "rolldown": "1.2.6",
    "rollup": "4.63.0",
    "rollup-plugin-external-globals": "0.13.0"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.4.0"
  }
}
